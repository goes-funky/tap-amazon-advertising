{
    "title": "CampaignEx",
    "type": "object",
    "properties": {
        "profileId": {
            "description": "The ID of the profile",
            "type": ["null","integer"]
        },
        "portfolioId": {
            "description": "The ID of the portfolio",
            "type":  ["null","integer"]
        },
        "campaignId": {
            "description": "The ID of the campaign",
            "type":  ["null","integer"]
        },
        "name": {
            "description": "The name of the campaign",
            "type":  ["null", "string"]
        },
        "tags": {
            "description": "A list of advertiser-specified custom identifiers for the campaign",
            "type":  ["null", "string"]
        },
        "targetingType": {
            "description": "Differentiates between a keyword-targeted and automatically targeted campaign",
            "type":  ["null", "string"],
            "oneOf": [
                "manual",
                "auto"
            ]
        },
        "bidding": {},
        "campaignType": {},
        "networks": {},
        "state": {
            "description": "Advertiser-specified state of the campaign",
            "type":["null", "string"],
            "oneOf": [
                "enabled",
                "paused",
                "archived"
            ]
        },
        "dailyBudget": {
            "description": "Daily budget for the campaign in dollars",
            "type": ["null","number"],
            "minimum": 1.0
        },
        "startDate": {
            "description": "The date the campaign will go or went live as YYYYMMDD",
            "type":  ["null", "string"]
        },
        "endDate": {
            "description": "The optional date the campaign will stop running as YYYYMMDD",
            "type":  ["null", "string"]
        },
        "premiumBidAdjustment": {
            "description": "When enabled, Amazon will increase the default bid for your ads that are eligible to appear in this placement. See developer notes for more information.",
            "type": ["null","boolean"]
        },
        "placement": {
            "description": "Ad placement. Only returned when segment is set to placement.",
            "type": ["null", "string"],
            "oneOf": [
                "Top of Search on-Amazon",
                "Other on-Amazon"
            ]
        },
        "creationDate": {
            "description": "The date the campaign was created as epoch time in milliseconds",
            "type":  ["null","integer"]
        },
        "lastUpdatedDate": {
            "description": "The date the campaign was last updated as epoch time in milliseconds",
            "type":  ["null","integer"]
        },
        "servingStatus": {
            "description": "The computed status, accounting for campaign out of budget, policy violations, etc. See developer notes for more information.",
            "type":  ["null", "string"],
            "oneOf": [
                "CAMPAIGN_ARCHIVED",
                "CAMPAIGN_PAUSED",
                "CAMPAIGN_STATUS_ENABLED",
                "ADVERTISER_PAYMENT_FAILURE",
                "CAMPAIGN_OUT_OF_BUDGET",
                "ACCOUNT_OUT_OF_BUDGET"
            ]
        },
        "bidOptimization": {
            "type": ["null", "boolean"]
        },
        "budget": {
            "type": ["null", "number"]
        },
        "budgetType": {
            "type": ["null", "string"]
        },
        "spendingPolicy": {
            "type": ["null", "string"]
        },
        "brandEntityId": {
            "type": ["null", "string"]
        },
        "landingPage": {
            "title": "LandingPage",
            "type": ["null","object"],
            "properties": {
                "pageType": {
                    "type":  ["null", "string"]
                },
                "url": {
                    "type":  ["null", "string"]
                }
            }
        },
        "bidMultiplier": {
            "type": ["null", "number"]
        },
        "bidAdjustments": {
            "title": "bidAdjustments",
            "type": ["null","object"],
            "description": "List of bid adjustment for each placement group. BidMultiplier cannot be specified when bidAdjustments presents. Not supported for video campaigns",
            "properties": {
                "bidAdjustmentPredicate": {
                    "type":  ["null", "string"]
                },
                "bidAdjustmentPercent": {
                    "type":  ["null", "number"]
                }
            }
        },
        "adFormat": {
            "description": "The type of ad format.",
            "type": ["null", "string"]
        },
        "creative": {
            "title": "creative",
            "type": ["null","object"],
            "description": "Note that the values of each field in this object are immutable for an existing campaign.",
            "properties": {
                "brandName": {
                    "type":  ["null", "string"]
                },
                "brandLogoAssetID": {
                    "type":  ["null", "string"]
                },
                "brandLogoUrl": {
                    "type":  ["null", "string"]
                },
                "headline": {
                    "type":  ["null", "string"]
                },
                "asins": {
                    "type":  ["null", "string"]
                },
                "shouldOptimizeAsins": {
                    "type": ["null","boolean"]
                }
            }
        }
    }
}
